@startuml cu59-consultar-ventas-normal
' CU-59 Consultando las ventas del periodo - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-59 Consultando las ventas del periodo (flujo normal)

actor Administrador
participant "V_ListaVentas" as V
participant "C_Ventas" as C
participant ":Venta" as VT

Administrador -> V : abre "Ventas del periodo"
V -> C : listarVentas(periodo vigente)
C -> VT : obtener(periodo)
VT --> C : ventas del periodo
C -> C : totaliza el monto vendido del periodo
C --> V : listado y total del periodo
V --> Administrador : muestra las ventas ordenadas y el total
Administrador -> V : ajusta el rango o filtra por cliente o producto
V -> C : listarVentas(rango, filtro)
C -> VT : obtener(criterio)
VT --> C : ventas que cumplen el criterio
C -> C : recalcula el total del criterio
C --> V : listado y total filtrados
Administrador -> V : selecciona una venta para ver su detalle y su despacho
V --> Administrador : muestra el detalle completo

@enduml
