@startuml cu89-ver-versiones-normal
' CU-89 Consultando el historial de versiones - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-89 Consultando el historial de versiones (flujo normal)

actor Sistema
participant "V_VersionesDocumento" as V
participant "C_DocumentosLegales" as C
participant ":DocumentoLegal" as D
participant ":VersionDocumento" as VD

Sistema -> V : selecciona documento y abre historial de versiones
V -> C : obtenerVersiones(documentoId)
C -> D : obtenerDocumento(documentoId)
D --> C : documento encontrado
C -> VD : obtenerVersiones(documento)
VD --> C : versiones ordenadas de mas reciente a mas antigua
C --> V : historial completo de versiones
V --> Sistema : muestra historial de versiones

@enduml
