@startuml cu89-renovar-documento-normal
' CU-89 Renovando o actualizando un documento - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-89 Renovando o actualizando un documento (flujo normal)

actor Administrador
participant "V_ListaDocumentos" as V
participant "C_Documentos" as C
participant ":documental_documentolegal" as DL
participant ":documental_versiondocumento" as VD
participant ":mezcla_alerta" as AL
participant ":acceso_bitacoraauditoria" as BA

Administrador -> V : selecciona un documento por vencer o vencido y "Renovar"
Administrador -> V : adjunta el archivo, ingresa la nueva vigencia y "Renovar documento"
V -> C : renovar(documento, archivo, fecha_emision, fecha_vencimiento)
C -> C : valida archivo y que el vencimiento sea posterior al vigente
C -> DL : actualizar(fecha_emision, fecha_vencimiento, estado = "vigente")
DL --> C : documento actualizado
C -> VD : marcarNoVigente(version anterior)
C -> VD : crear(documento, archivo, version + 1, vigencia nueva, vigente = verdadero)
VD --> C : nueva version vigente
C -> AL : resolver(alerta activa del documento)
AL --> C : alerta resuelta
C -> BA : registrar("Renovacion de documento legal")
C --> V : renovacion confirmada
V --> Administrador : documento vigente con su historial conservado

@enduml
