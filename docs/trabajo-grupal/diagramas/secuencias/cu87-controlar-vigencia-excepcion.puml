@startuml cu87-controlar-vigencia-excepcion
' CU-87 Controlando la vigencia de los documentos - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-87 Controlando la vigencia de los documentos (flujo de excepcion)

actor Sistema
participant "V_Documentos" as V
participant "C_DocumentosLegales" as C
participant ":DocumentoLegal" as D

Sistema -> V : solicita documentos por vencer o vencidos
V -> C : consultarVigencia(dias)
C -> D : obtenerPorVencer(dias)
D --> C : lista vacia
C -> D : obtenerVencidos()
D --> C : lista vacia
alt no hay documentos por vencer ni vencidos
  C --> V : sin documentos en estado critico
  V --> Sistema : muestra mensaje "no hay documentos por vencer ni vencidos"
end

@enduml
