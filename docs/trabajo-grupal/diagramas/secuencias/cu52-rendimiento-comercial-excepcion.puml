@startuml cu52-rendimiento-comercial-excepcion
' CU-52 Proyectando el rendimiento comercial de un camion - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-52 Rendimiento comercial (excepcion: sin origen, parametros faltantes o volumen invalido)

actor Administrador
participant "V_Proyecciones" as V
participant "C_Proyecciones" as C
participant ":mantenedores_material" as M
participant ":configuracion_parametroconversion" as PC
participant ":proyecciones_proyeccion" as P

Administrador -> V : elige el origen y presiona "Calcular rendimiento"
V -> C : proyectarComercial(origen)
alt no selecciona DetalleRecepcion ni ingresa volumen y material
  C --> V : error de validacion(indicar un origen)
  V --> Administrador : solicita completar uno de los dos caminos
else faltan parametros del material o de conversion
  C -> M : obtenerParametros(material)
  M --> C : parametros incompletos
  C -> PC : obtenerVigentes(rendimiento, sacos por m3, precio)
  PC --> C : parametro faltante
  C --> V : indica cual parametro falta
  V --> Administrador : no calcula el rendimiento
else volumen cero o negativo
  C --> V : error de validacion(volumen mayor a cero)
  V --> Administrador : solicita un volumen valido
else datos validos
  C -> P : crear(tipo="comercial", supuestos, valorProyectado)
  P --> C : proyeccion registrada
  C --> V : sacos, metros cubicos e ingreso estimados
end

@enduml
