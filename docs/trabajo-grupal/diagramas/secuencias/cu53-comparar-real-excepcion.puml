@startuml cu53-comparar-real-excepcion
' CU-53 Comparando el acumulado proyectado con el real - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-53 Comparar con lo real (excepcion: periodo en curso, sin datos o venta ausente)

actor Administrador
participant "V_Proyecciones" as V
participant "C_Proyecciones" as C
participant ":recepcion_detallerecepcion" as DR
participant ":inventario_inventario" as I
participant ":comercial_venta" as VT

Administrador -> V : selecciona una proyeccion y presiona "Comparar con lo real"
V -> C : compararConReal(proyeccion)
alt el periodo aun no termina
  C --> V : advierte comparacion parcial hasta la fecha
  V --> Administrador : permite continuar con los datos disponibles
else no hay recepciones ni movimientos de inventario del periodo
  C -> DR : obtenerRecibidoEnPeriodo(periodo)
  DR --> C : sin datos
  C -> I : obtenerProduccionEnPeriodo(periodo)
  I --> C : sin movimientos
  C --> V : no hay datos reales con que comparar
  V --> Administrador : informa y no calcula desviacion
else proyeccion comercial sin venta asociada
  C -> VT : obtenerIngresoEnPeriodo(periodo)
  VT --> C : sin venta asociada
  C -> C : compara volumen y produccion
  note right of C : el ingreso real se marca como no disponible,\nsin omitir la comparacion completa
  C --> V : proyectado, real y desviacion; ingreso no disponible
  V --> Administrador : muestra la comparacion parcial
end

@enduml
