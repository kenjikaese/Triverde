@startuml cu58-registrar-venta-normal
' CU-58 Registrando una venta de producto - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-58 Registrando una venta de producto (flujo normal)

actor Administrador
participant "V_RegistroVenta" as V
participant "C_Ventas" as C
participant ":Producto" as P
participant ":Venta" as VT
participant ":DetalleVenta" as DV

Administrador -> V : "Nueva venta"; selecciona el cliente
V -> C : listarProductosActivos()
C -> P : obtenerActivos()
P --> C : catalogo de productos con su unidad de venta
C --> V : catalogo disponible
Administrador -> V : selecciona el producto e ingresa la cantidad
Administrador -> V : presiona "Registrar venta"
V -> C : registrarVenta(cliente, producto, cantidad, unidad)
C -> P : obtenerPrecio(producto)
P --> C : precio configurado del producto
C -> C : subtotal = precio x cantidad; total de la venta
C -> VT : crear(cliente, estado=pendiente, total, fecha)
VT --> C : venta creada
C -> DV : crear(venta, producto, cantidad, unidad, precio, subtotal)
DV --> C : linea registrada
C -> C : registrarAuditoria("Registro de venta")
C --> V : venta confirmada
V --> Administrador : queda disponible para despacho y para la cuenta corriente

@enduml
