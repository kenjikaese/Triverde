@startuml cu68-trazabilidad-lote-excepcion
' CU-68 Consultando el detalle trazable de un lote entregado - excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-68 Consultando el detalle trazable de un lote entregado (excepcion: sin pila de origen, pila en proceso o sin descargas registradas)

actor Administrador
participant "V_TrazabilidadLote" as V
participant "C_Trazabilidad" as C
participant ":comercial_detalleventa" as DV
participant ":inventario_pila" as PI
participant ":inventario_composicionpila" as CP
participant ":inventario_aporterecepcionpila" as AP

Administrador -> V : selecciona la venta a trazar
V -> C : trazabilidad(venta)
C -> DV : obtenerLineas(venta)
alt ninguna linea de la venta tiene pila de origen
  DV --> C : lineas sin pila
  C --> V : trazable = no; advertencia de lote sin trazabilidad
  V --> Administrador : informa que el lote no cuenta con trazabilidad de compostaje
else la pila de origen sigue en proceso o no tiene descargas registradas
  DV --> C : linea con pila de origen
  C -> PI : obtener(pila)
  PI --> C : pila (estado)
  C -> CP : obtenerComposicion(pila)
  CP --> C : composicion registrada hasta ahora
  C -> AP : obtenerAportes(pila)
  AP --> C : aportes registrados (puede venir vacio)
  opt pila en estado distinto de cerrada
    C -> C : advertencia de composicion no definitiva
  end
  opt pila sin aportes registrados
    C -> C : advertencia de cadena hasta la composicion
  end
  C --> V : cadena disponible con sus advertencias
  V --> Administrador : muestra el detalle disponible con las advertencias
end

@enduml
