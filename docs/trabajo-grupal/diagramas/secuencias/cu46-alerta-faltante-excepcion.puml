@startuml cu46-alerta-faltante-excepcion
' CU-46 Generando la alerta de faltante de material - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-46 Generar la alerta de faltante (excepcion: faltante cubierto o alerta ya existente)

actor Sistema
participant "C_Mezcla" as C
participant ":Alerta" as A

Sistema -> C : entrega el resultado de la mezcla para evaluar la alerta
alt el faltante es cero o el inventario alcanza a cubrirlo
  C -> A : buscarActiva(pila, categoria)
  A --> C : existe una alerta activa previa que ya no aplica
  C -> A : resolver(alerta)
  A --> C : alerta resuelta
  C --> Sistema : no genera ninguna alerta nueva
else ya existe una alerta activa para esa pila y categoria
  C -> A : buscarActiva(pila, categoria)
  A --> C : alerta activa existente
  C -> A : actualizar(faltante, disponible, mensaje)
  A --> C : alerta actualizada sin crear un duplicado
  C --> Sistema : mantiene una sola alerta activa por pila y categoria
end

@enduml
