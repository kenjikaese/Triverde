@startuml cu40-harneado-normal
' CU-40 Registrando el harneado de una pila - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-40 Registrando el harneado de una pila (flujo normal)

actor Operador
participant "V_RegistroProceso" as V
participant "C_ProcesosPila" as C
participant ":Pila" as P
participant ":ProcesoPila" as PP

Operador -> V : harnea el material y presiona "Registrar harneado"
V --> Operador : muestra el formulario con la fecha actual
Operador -> V : confirma o ajusta la fecha
V -> C : registrarProceso(tipo="harneado", pila, fecha)
C -> P : obtener(pila)
P --> C : pila con estado "en proceso"
C -> C : validarEstado(pila, "en proceso")
C -> C : validarFechaNoFutura(fecha)
C -> PP : crear(tipo="harneado", pila, fecha, id_local)
PP --> C : harneado registrado
C --> V : proceso registrado
V --> Operador : confirma y deja la pila lista para iniciar el reposo

@enduml
