@startuml cu34-inventario-consulta-normal
' CU-34 Consultando el inventario por material y estado - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-34 Consultando el inventario por material y estado (flujo normal)

actor Operador
participant "V_Inventario" as V
participant "C_Inventario" as C
participant ":Inventario" as I
participant ":Material" as M

Operador -> V : abre la pantalla de inventario
V -> C : listarInventario()
C -> I : obtenerSaldos()
I --> C : saldos registrados por material y etapa
C -> M : obtenerMaterialesActivos()
M --> C : catalogo de materiales
C -> C : completarGrilla(material x etapa, faltantes en cero)
C --> V : existencias por material y etapa
V --> Operador : muestra el inventario agrupado
Operador -> V : ingresa un filtro por material o por etapa
V -> C : listarInventario(material, etapa)
C -> I : obtenerSaldos(material, etapa)
I --> C : saldos que cumplen el criterio
C --> V : existencias filtradas
V --> Operador : muestra solo las coincidencias

@enduml
