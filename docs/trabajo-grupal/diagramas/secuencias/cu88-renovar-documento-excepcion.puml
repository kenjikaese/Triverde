@startuml cu88-renovar-documento-excepcion
' CU-88 Renovando un documento legal - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-88 Renovando un documento legal (flujo de excepcion)

actor Sistema
participant "V_Documentos" as V
participant "C_DocumentosLegales" as C

Sistema -> V : selecciona documento y pulsa renovar
V -> C : renovarDocumento(id, fechaEmision, fechaVencimiento, usuario)
alt documento no existe
  C --> V : error "documento inexistente"
  V --> Sistema : muestra mensaje de error
else fecha de vencimiento anterior a la emision
  C --> V : error "fecha de vencimiento invalida"
  V --> Sistema : muestra mensaje de validacion
else faltan datos de la renovacion
  C --> V : error "datos incompletos"
  V --> Sistema : muestra mensaje de validacion
end

@enduml
