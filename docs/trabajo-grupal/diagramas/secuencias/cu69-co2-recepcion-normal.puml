@startuml cu69-co2-recepcion-normal
' CU-69 Calculando el CO2 evitado por un camion recibido - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-69 Calculando el CO2 evitado por un camion recibido (flujo normal)

actor Sistema
participant "C_Ambiental" as C
participant ":recepcion_recepcion" as R
participant ":recepcion_detallerecepcion" as DR
participant ":configuracion_parametroconversion" as PC
participant ":trazabilidad_indicadorambiental" as IA

Sistema -> C : detecta Recepcion en estado recibida
C -> R : obtener(recepcion)
R --> C : recepcion confirmada y fecha
C -> DR : sumarPesoDerivado(recepcion)
DR --> C : peso total recibido
C -> PC : obtener(co2_evitado_camion)
PC --> C : factor ambiental vigente
C -> C : co2_evitado_kg = peso_total_kg x factor
C -> IA : crearOActualizar(recepcion, co2, metodo, fecha)
IA --> C : indicador persistido sin duplicar
C --> Sistema : acumulado ambiental actualizado

@enduml
