@startuml cu86-subir-documento-normal
' CU-86 Subiendo un documento legal con archivo adjunto - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-86 Subiendo un documento legal con archivo adjunto (flujo normal)

actor Sistema
participant "V_Documentos" as V
participant "C_DocumentosLegales" as C
participant ":DocumentoLegal" as D

Sistema -> V : abre el formulario de nuevo documento
V -> C : enviarDatos(nombre, tipo, descripcion, archivo, fechas)
C -> C : valida campos obligatorios y formato de archivo
C -> D : crearDocumento(datos, usuario)
D --> C : documento creado con estado activo
C --> V : confirmacion y documento disponible
V --> Sistema : documento visible en el listado

@enduml
