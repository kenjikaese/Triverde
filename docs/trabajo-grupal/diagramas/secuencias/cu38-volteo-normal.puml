@startuml cu38-volteo-normal
' CU-38 Registrando un volteo de la pila - flujo normal
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-38 Registrando un volteo de la pila (flujo normal)

actor Operador
participant "V_RegistroProceso" as V
participant "C_ProcesosPila" as C
participant ":Pila" as P
participant ":ProcesoPila" as PP

Operador -> V : mide la temperatura y presiona "Registrar volteo"
V --> Operador : muestra el formulario con la fecha actual
Operador -> V : ingresa la temperatura medida y confirma
V -> C : registrarProceso(tipo="volteo", pila, temperatura)
C -> P : obtener(pila)
P --> C : pila con estado "en proceso"
C -> C : validarEstado(pila, "en proceso")
C -> C : validarTemperaturaInformada(temperatura)
C -> PP : crear(tipo="volteo", pila, fecha, temperatura, id_local)
PP --> C : volteo registrado
C --> V : proceso registrado
V --> Operador : confirma el volteo y lo agrega al historial de la pila

@enduml
