@startuml cu62-estado-pago-excepcion
' CU-62 Registrando el estado de pago de un cliente - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-62 Registrar el estado de pago (excepcion: cliente sin movimientos o sin estado seleccionado)

actor Administrador
participant "V_CuentaCorriente" as V
participant "C_Cobros" as C
participant ":mantenedores_cliente" as CL

alt el cliente no tiene ventas ni cobros asociados
  Administrador -> V : presiona "Actualizar estado de pago"
  V -> C : actualizarEstadoPago(cliente, estado_pago)
  C -> CL : verificarMovimientos(cliente)
  CL --> C : sin ventas ni cobros
  C --> V : no hay cuenta corriente que conciliar
  V --> Administrador : no permite la actualizacion
else guarda sin seleccionar un estado de pago
  Administrador -> V : presiona "Guardar" sin elegir un estado
  V --> Administrador : senala el campo obligatorio y no guarda el cambio
end

@enduml
