@startuml cu86-subir-documento-excepcion
' CU-86 Subiendo un documento legal con archivo adjunto - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-86 Subiendo un documento legal con archivo adjunto (flujo de excepcion)

actor Sistema
participant "V_Documentos" as V
participant "C_DocumentosLegales" as C

Sistema -> V : abre el formulario de nuevo documento
V -> C : enviarDatos(nombre, tipo, descripcion, archivo, fechas)
C -> C : valida campos obligatorios y formato de archivo
alt falta nombre o tipo o fecha de emision
  C --> V : error "campos obligatorios incompletos"
  V --> Sistema : muestra mensaje de validacion
else archivo con formato no permitido
  C --> V : error "formato de archivo no permitido"
  V --> Sistema : muestra mensaje de validacion
else fecha de vencimiento anterior a la emision
  C --> V : error "fecha de vencimiento invalida"
  V --> Sistema : muestra mensaje de validacion
end

@enduml
