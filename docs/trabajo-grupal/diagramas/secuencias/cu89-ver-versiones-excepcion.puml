@startuml cu89-ver-versiones-excepcion
' CU-89 Consultando el historial de versiones - flujo de excepcion
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #EAF3E7
skinparam ParticipantBorderColor #2E5E2A
skinparam ActorBackgroundColor #EAF3E7
skinparam ActorBorderColor #2E5E2A
skinparam sequenceLifeLineBorderColor #9CC49A
skinparam ArrowColor #4B7A46

title CU-89 Consultando el historial de versiones (flujo de excepcion)

actor Sistema
participant "V_VersionesDocumento" as V
participant "C_DocumentosLegales" as C
participant ":DocumentoLegal" as D

Sistema -> V : selecciona documento y abre historial de versiones
V -> C : obtenerVersiones(documentoId)
C -> D : obtenerDocumento(documentoId)
alt documento no existe
  C --> V : error "documento inexistente"
  V --> Sistema : muestra mensaje de error
else documento sin versiones registradas
  C --> V : historial vacio
  V --> Sistema : muestra mensaje "el documento no tiene versiones registradas"
else archivo de la version no disponible
  C --> V : advertencia "una o mas versiones no tienen archivo disponible"
  V --> Sistema : muestra historial con advertencia
end

@enduml
