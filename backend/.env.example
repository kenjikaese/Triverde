# Copia este archivo a .env y ajusta los valores.
# En Docker Compose estas variables vienen del propio compose; este .env sirve
# para correr manage.py fuera de Docker.

DJANGO_SECRET_KEY=dev-insecure-key-cambiar
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos. Si se omite, usa SQLite (db.sqlite3) para correr sin Docker.
# DATABASE_URL=postgres://triverde:triverde@localhost:5432/triverde

CORS_ALLOW_ALL=true
